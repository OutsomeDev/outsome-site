{
  "outputDirectory": "out",
  "cleanUrls": true,
  "redirects": [
    { "source": "/apply", "destination": "/ko/apply", "permanent": false },
    { "source": "/apply.html", "destination": "/ko/apply", "permanent": false }
  ],
  "headers": [
    {
      "source": "/assets/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
